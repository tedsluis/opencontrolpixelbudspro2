<?xml version="1.0" encoding="utf-8"?>
<!--
    Component ownership stays with the module that implements it
    (BudsForegroundService), so consuming apps don't need to duplicate that
    declaration. Permissions are declared here too, not just in :app's own
    manifest — this module is where the permission-gated Bluetooth APIs are
    actually called (RfcommBudsTransport, BudsCompanionPairing), and Android
    Gradle Plugin's own lint (MissingPermission) analyzes each library module
    against its own manifest, not the final merged app manifest. Manifest
    merging combines this with :app's own declarations (which carry the
    AGENTS.md §2 justification comments) without conflict — declaring the
    same permission in both is redundant, not an error.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- CompanionDeviceManager.associate() (BudsCompanionPairing, AGENTS.md §7's sanctioned
         discovery path) throws IllegalStateException at call time, not at manifest-parse or
         install time, if this isn't declared — found via a real crash on hardware
         (ai-sessions/0035). required="true" because this app genuinely cannot pair without CDM,
         no fallback path exists. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />

    <application>
        <service
            android:name=".BudsForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
