<?xml version="1.0" encoding="utf-8"?>
<!--
    No INTERNET permission anywhere in this manifest, ever (AGENTS.md §1) — a
    CI/lint check should assert this remains true (ARCHITECTURE.md §14).

    Every permission below is declared because `ai-sessions/0033`'s Phase 4
    hardware layer (RfcommBudsTransport, BudsCompanionPairing,
    HfpBatteryReader, BluetoothStateObserver, BudsForegroundService) actually
    uses it — none is speculative (AGENTS.md §2's "any additional permission
    must be justified" rule).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RFCOMM socket I/O against the already-bonded/CDM-selected device
         (RfcommBudsTransport, BudsCompanionPairing). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Flagged neverForLocation per AGENTS.md §2 — this app never does
         device-discovery scanning; the only scan this permission covers is
         the bounded Fast Pair Battery Notification exception (AGENTS.md §7,
         DECISIONS.md ADR-006), not yet implemented this session (Battery
         Option A is out of this session's scope, ARCHITECTURE.md §5a), but
         the manifest flag itself is a static declaration independent of
         which battery option is wired up. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- BudsForegroundService's persistent connection-status notification
         (AGENTS.md §2, ARCHITECTURE.md §6.0a). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- CompanionDeviceManager.associate() (BudsCompanionPairing) throws IllegalStateException at
         call time without this — found via a real crash on hardware (ai-sessions/0035); also
         declared in :hardware's own manifest, redundant with this one, not an error (see that
         file's own comment for why both). required="true" — this app has no pairing path other
         than CDM. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />

    <application
        android:name="io.github.tedsluis.opencontrolpixelbuds.app.OpenControlApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenControlPixelBuds">

        <!-- Fully-qualified class names here, not the usual ".ClassName" shorthand: this
             module's `namespace` (build.gradle.kts) is "io.github.tedsluis.opencontrolpixelbuds",
             but OpenControlApplication/MainActivity's actual Kotlin package is
             "io.github.tedsluis.opencontrolpixelbuds.app" (one level deeper, matching this
             source tree's own directory layout) — a relative name resolves against the
             manifest's namespace, not a class's real package, so ".OpenControlApplication" was
             silently resolving to a class that doesn't exist and crashing on launch with
             ClassNotFoundException. Confirmed by installing a real debug APK on hardware and
             reading the resulting crash: the exact malformed class name it looked for was
             "io.github.tedsluis.opencontrolpixelbuds.OpenControlApplication", missing the ".app"
             segment — lint's own `MissingClass` check had already flagged this and was
             incorrectly suppressed in app/build.gradle.kts (see that file's own corrected
             comment) rather than investigated fully. -->
        <activity
            android:name="io.github.tedsluis.opencontrolpixelbuds.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ANC Quick Settings tile (ai-sessions/0042). android:permission is the permission the *binding caller* must hold
             (only the system does); it is not a permission this app requests — the requested-permission set is unchanged
             (AGENTS.md §2). The tile never opens the session and never starts a service; a tap while the app is not connected
             opens the app. -->
        <service
            android:name="io.github.tedsluis.opencontrolpixelbuds.app.AncTileService"
            android:exported="true"
            android:icon="@drawable/ic_anc_tile"
            android:label="@string/tile_anc_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
