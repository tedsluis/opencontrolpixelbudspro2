<?xml version="1.0" encoding="utf-8"?>
<!--
    No INTERNET permission anywhere in this manifest, ever (AGENTS.md §1) — a
    CI/lint check should assert this remains true (ARCHITECTURE.md §14).

    Every permission below is declared because the hardware layer
    (RfcommBudsTransport, BudsCompanionPairing, OsConnectionObserver,
    BluetoothStateObserver, BudsForegroundService) actually uses it — none is
    speculative (AGENTS.md §2's "any additional permission must be justified"
    rule). BLUETOOTH_SCAN was removed 2026-09-24 (maintainer-approved, 0044
    finding APP-13): no code scans; it returns, flagged neverForLocation, only
    with DECISIONS.md ADR-006's bounded battery-advertisement scan.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RFCOMM socket I/O against the already-bonded/CDM-selected device
         (RfcommBudsTransport, BudsCompanionPairing). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BudsForegroundService's persistent connection-status notification
         (AGENTS.md §2, ARCHITECTURE.md §6.0a). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- CompanionDeviceManager.associate() (BudsCompanionPairing) throws IllegalStateException at
         call time without this — found via a real crash on hardware (ai-sessions/0035); also
         declared in :hardware's own manifest, redundant with this one, not an error (see that
         file's own comment for why both). required="true" — this app has no pairing path other
         than CDM. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />

    <!-- Not declared here, but in the merged manifest (ai-sessions/0058 A58-GOV-08; commented in ai-sessions/0062 T-3):
         AndroidX Core adds the permission "io.github.tedsluis.opencontrolpixelbuds.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
         (protectionLevel="signature") and its uses-permission, for its own ContextCompat.registerReceiver(…,
         RECEIVER_NOT_EXPORTED). It is private to this app — only an app signed with this app's key could hold it — and grants
         nothing outside the app. It is not a runtime permission and asks the user for nothing. -->

    <!-- DECISIONS.md ADR-063 (ai-sessions/0089, maintainer-approved in chat 2026-10-13): package visibility
         for exactly one package, so PlayServicesProbe can ask PackageManager whether Google Play services is
         installed and enabled for this user — the Settings card "Noise control with Google Play services"
         shows it as information only. Not a permission; nothing of that package is imported, bound, started
         or read, and no network is used (AGENTS.md §1 and its dated note of 2026-10-13). Without this entry
         Android 11+ hides the package and every answer would be "not found". ADR-050's links still need no
         <queries> (startActivity does not require package visibility). -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name="io.github.tedsluis.opencontrolpixelbuds.app.OpenControlApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenControlPixelBuds">

        <!-- Fully-qualified class names here, not the usual ".ClassName" shorthand: this
             module's `namespace` (build.gradle.kts) is "io.github.tedsluis.opencontrolpixelbuds",
             but OpenControlApplication/MainActivity's actual Kotlin package is
             "io.github.tedsluis.opencontrolpixelbuds.app" (one level deeper, matching this
             source tree's own directory layout) — a relative name resolves against the
             manifest's namespace, not a class's real package, so ".OpenControlApplication" was
             silently resolving to a class that doesn't exist and crashing on launch with
             ClassNotFoundException. Confirmed by installing a real debug APK on hardware and
             reading the resulting crash: the exact malformed class name it looked for was
             "io.github.tedsluis.opencontrolpixelbuds.OpenControlApplication", missing the ".app"
             segment — lint's own `MissingClass` check had already flagged this and was
             incorrectly suppressed in app/build.gradle.kts (see that file's own corrected
             comment) rather than investigated fully. -->
        <activity
            android:name="io.github.tedsluis.opencontrolpixelbuds.app.MainActivity"
            android:exported="true"
            android:label="@string/launcher_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ANC Quick Settings tile (ai-sessions/0042). android:permission is the permission the *binding caller* must hold
             (only the system does); it is not a permission this app requests — the requested-permission set is unchanged
             (AGENTS.md §2). The tile never opens the session and never starts a service; a tap while the app is not connected
             opens the app. -->
        <service
            android:name="io.github.tedsluis.opencontrolpixelbuds.app.AncTileService"
            android:exported="true"
            android:icon="@drawable/ic_anc_tile"
            android:label="@string/tile_anc_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
